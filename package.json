{
  "name": "gully-codex-pet",
  "version": "1.0.0",
  "description": "Good Golly He's Gully - A thugged-out beach bum seagull companion for OpenAI Codex",
  "main": "pets/gully/pet.json",
  "scripts": {
    "install": "mkdir -p ~/.codex/pets && cp -R pets/gully ~/.codex/pets/",
    "generate": "./scripts/generate-gully.sh",
    "assemble": "./scripts/assemble-spritesheet.sh",
    "validate": "./scripts/validate-spritesheet.sh",
    "install-pet": "./scripts/install-pet.sh",
    "test": "./scripts/test-pet.sh",
    "full-workflow": "./scripts/generate-gully.sh && ./scripts/assemble-spritesheet.sh && ./scripts/validate-spritesheet.sh && ./scripts/install-pet.sh && ./scripts/test-pet.sh"
  },
  "keywords": [
    "codex",
    "pet",
    "seagull",
    "pixel-art",
    "animated",
    "desktop-companion",
    "beach-bum",
    "long-beach",
    "90s-nostalgia"
  ],
  "author": "Alex Baldman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexBaldman/gully-codex-pet.git"
  },
  "bugs": {
    "url": "https://github.com/AlexBaldman/gully-codex-pet/issues"
  },
  "homepage": "https://github.com/AlexBaldman/gully-codex-pet#readme",
  "pet": {
    "name": "Good Golly He's Gully",
    "style": "pixel",
    "states": 9,
    "format": "spritesheet",
    "grid": "8x11",
    "cellSize": "192x208",
    "lookDirections": 16,
    "spriteVersion": 2
  }
}
